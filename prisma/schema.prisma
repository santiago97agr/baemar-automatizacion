generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AiActivity {
  id            String           @id @default(cuid())
  messageId     String           @unique
  subject       String
  from          String
  body          String           @default("")
  attachments   String?          // JSON array con metadatos de adjuntos
  title         String
  type          String
  priority      String
  description   String           @default("")
  summary       String           @default("")
  aiRaw         String           @default("") // JSON crudo devuelto por la IA
  needsReview   Boolean          @default(false)
  reviewReason  String?
  reviewStatus  String           @default("not_required") // not_required | pending | reviewed
  status        String           @default("ok")           // ok | error
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  targets       ActivityTarget[]
  feedback      Feedback[]
  errors        ErrorLog[]
}

model ActivityTarget {
  id            String     @id @default(cuid())
  activityId    String
  activity      AiActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  targetType    String     // notion | erp | ...
  targetId      String?    // id externo
  targetUrl     String?    // link profundo
  status        String     @default("pending") // pending | ok | error
  errorMessage  String?
  payload       String?    // JSON enviado/pendiente
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([targetType, status])
}

model Feedback {
  id              String     @id @default(cuid())
  activityId      String
  activity        AiActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  emailMessageId  String?
  type            String     // correction | comment
  text            String
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ErrorLog {
  id            String      @id @default(cuid())
  source        String      // n8n | ia | notion | processing | erp
  message       String
  activityId    String?
  activity      AiActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?
}
